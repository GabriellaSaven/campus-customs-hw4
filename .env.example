# Campus Customs — environment variables
# Copy this file to `.env` in the repo root and fill in your real key.
#   cp .env.example .env
# The .env file is git-ignored and must never be committed.

# Required: your Portkey API key (used to reach OpenAI through Portkey).
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional overrides (defaults shown):
# MODEL_NAME=gpt-5.6-luna
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_PROVIDER=openai
# JWT_SECRET=change-me-in-production
